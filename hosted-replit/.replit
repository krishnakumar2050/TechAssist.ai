modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
NEBIUS_MODEL = "Qwen/Qwen3-30B-A3B-Instruct-2507"
PINECONE_INDEX_HOST = "https://techassist-laptops-hybrid-4rxtk29.svc.aped-4627-b74a.pinecone.io"
PINECONE_INDEX_NAME = "techassist-laptops-hybrid"
PINECONE_NAMESPACE = "laptop-corpus-recursive-v2"

[userenv.production]
TECHASSIST_SYNC_ON_STARTUP = "true"

[nix]
channel = "stable-25_05"
