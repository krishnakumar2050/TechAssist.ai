# Store credentials with techassist secrets-store; do not put API keys here.
SECRETS_DIR=.secrets
PINECONE_INDEX=techassist-laptops-hybrid
PINECONE_NAMESPACE=laptop-corpus-recursive-v2
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSIONS=1024
# Optional answer generation; set to a Responses API model available to your account.
CHAT_MODEL=gpt-4.1-mini
CORPUS_PATH=knowledge_corpus/rag_chunks.jsonl
CHUNK_TOKENS=700
CHUNK_OVERLAP=100
BATCH_SIZE=32

# Stage 1 retrieves 20 similar chunks; stage 2 returns the best 5 by default.
RETRIEVAL_CANDIDATES=20
RERANK_MODEL=bge-reranker-v2-m3

# Web application. Keys must stay in encrypted credential storage.
APP_ORIGIN=http://127.0.0.1:8000
AUTH_MODE=local
COOKIE_SECURE=false
# guided = deterministic evidence-backed steps; ollama = LLM-selected workflow actions.
RESPONSE_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
RELEVANCE_THRESHOLD=0.03
# Leave DATABASE_URL unset for auto-detection: project Docker PostgreSQL, else local SQLite.
# For configured PostgreSQL use {password}; the value is loaded from .secrets/database.enc.
# DATABASE_URL=postgresql+psycopg://techassist:{password}@127.0.0.1:54329/techassist
# Enterprise deployment only; provide OIDC_CLIENT_SECRET via process environment, not this file.
# OIDC_METADATA_URL=https://your-identity-provider/.well-known/openid-configuration
# OIDC_CLIENT_ID=your-app-id
